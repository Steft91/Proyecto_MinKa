# Copy this file to .env for local development. Never commit .env.

# PostgreSQL
POSTGRES_DB=minka
POSTGRES_USER=minka
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://minka:change-me@localhost:5432/minka?schema=public

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail API / Google email sender
GMAIL_SENDER_EMAIL=
GMAIL_ACCESS_TOKEN=

# Validación del barrio. Ruta absoluta o relativa a la raíz del repositorio.
MINKA_NEIGHBORHOOD_GEOJSON=
# Entrega interna al módulo A. Ambos valores son necesarios.
MINKA_EVALUATION_URL=
MINKA_EVALUATION_TOKEN=
MINKA_EVALUATION_CALLBACK_TOKEN=
MINKA_NOTIFICATIONS_URL=
MINKA_NOTIFICATIONS_TOKEN=

